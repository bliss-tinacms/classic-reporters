---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/data';

type NavItem = { label?: string | null; href?: string | null };
type NavigationDocument = {
  title?: string | null;
  items?: (NavItem | null)[] | null;
};
interface Props {
  config?: CmsConfig | null;
  navigation?: NavigationDocument | null;
}

const { config, navigation } = Astro.props;
const cfg = config as any;
const seo = cfg?.seo ?? {};
const footer = cfg?.footer ?? {};
const currentYear = new Date().getFullYear();
const siteTitle = seo.title || 'Classic Reporters';
const logo = seo.footerLogo || seo.logo || '/classic-assets/9386b5086f1935ab.png';
const description =
  footer.description ||
  seo.description ||
  'National news, reported plainly. Original reporting, clearly attributed.';
const editorialEmail = footer.editorialEmail || 'editorial@classicreporters.com';
const infoEmail = footer.infoEmail || 'info@classicreporters.com';
const ctaTitle =
  footer.ctaTitle ||
  'Story tips, corrections, and letters to the editor all reach a real editor.';
const ctaButtonText = footer.ctaButtonText || 'Contact the newsroom';
const ctaButtonLink = footer.ctaButtonLink || '/contact/';

const sectionLinks: NavItem[] = [
  { label: 'U.S. News', href: '/us-news/' },
  { label: 'World News', href: '/world-news/' },
  { label: 'Business', href: '/business/' },
  { label: 'Technology', href: '/technology/' },
  { label: 'Health', href: '/health/' },
  { label: 'Entertainment', href: '/entertainment/' },
  { label: 'Lifestyle', href: '/lifestyle/' },
];
const defaultCompanyLinks: NavItem[] = [
  { label: 'About Us', href: '/about/' },
  { label: 'Our Team', href: '/our-team/' },
  { label: 'Contact Us', href: '/contact/' },
  { label: 'Editorial Guidelines', href: '/editorial-guidelines/' },
  { label: 'Write for Us', href: '/write-for-us/' },
];
const configuredCompanyLinks = ((navigation?.items ?? []) as NavItem[]).filter(
  (item) => item?.label && item?.href,
);
const companyLinks = configuredCompanyLinks.length
  ? configuredCompanyLinks
  : defaultCompanyLinks;
const legalLinks = [
  { label: 'Privacy', href: '/privacy-policy/' },
  { label: 'Terms', href: '/terms-of-use/' },
  { label: 'Cookie', href: '/cookie-policy/' },
  { label: 'AI', href: '/ai-policy/' },
  { label: 'DMCA', href: '/dmca-policy/' },
  { label: 'Sponsored', href: '/sponsored-content-policy/' },
  { label: 'Sitemap', href: '/sitemap' },
];
---

<section class="cr-exact-cta" aria-label="Contact the newsroom">
  <div class="cr-exact-cta__inner">
    <p data-tina-field={footer ? tinaField(footer, 'ctaTitle') : undefined}>
      {ctaTitle}
    </p>
    <a
      href={ctaButtonLink}
      data-tina-field={footer ? tinaField(footer, 'ctaButtonText') : undefined}
    >
      {ctaButtonText} <span>→</span>
    </a>
  </div>
</section>

<footer class="cr-exact-footer" data-brand-footer>
  <div class="cr-exact-footer__inner">
    <div class="cr-exact-footer__grid">
      <div class="cr-exact-footer__brand-row">
        <a class="cr-exact-footer__logo" href="/" aria-label={`${siteTitle} home`}>
          <img
            src={logo}
            alt={siteTitle}
            data-tina-field={seo ? tinaField(seo, 'footerLogo') : undefined}
          />
        </a>
        <div class="cr-exact-footer__summary">
          <span data-tina-field={footer ? tinaField(footer, 'description') : undefined}>
            {description}
          </span>
          <span class="cr-exact-footer__emails">
            <a
              href={`mailto:${editorialEmail}`}
              data-tina-field={footer ? tinaField(footer, 'editorialEmail') : undefined}
            >
              {editorialEmail}
            </a>
            <a
              href={`mailto:${infoEmail}`}
              data-tina-field={footer ? tinaField(footer, 'infoEmail') : undefined}
            >
              {infoEmail}
            </a>
          </span>
        </div>
      </div>

      <div class="cr-exact-footer__link-grid">
        <div class="cr-exact-footer__sections">
          <span class="cr-exact-footer__eyebrow">Sections</span>
          <nav aria-label="Sections">
            {sectionLinks.map((item) => <a href={item.href || '#'}>{item.label}</a>)}
          </nav>
        </div>
        <div class="cr-exact-footer__company">
          <span class="cr-exact-footer__eyebrow">Company</span>
          <nav aria-label={navigation?.title || 'Company'}>
            {
              companyLinks.map((item) => (
                <a
                  href={item.href || '#'}
                  data-tina-field={
                    configuredCompanyLinks.length ? tinaField(item, 'label') : undefined
                  }
                >
                  {item.label}<span>↗</span>
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>

    <div class="cr-exact-footer__legal">
      <span>© {currentYear} {siteTitle}. All rights reserved.</span>
      <nav aria-label="Legal">
        {legalLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </div>
</footer>
