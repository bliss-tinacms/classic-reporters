---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/data';
type NavItem={label?:string|null;href?:string|null};
type NavigationDocument={title?:string|null;items?:(NavItem|null)[]|null};
interface Props{config?:CmsConfig|null;navigation?:NavigationDocument|null}
const {config,navigation}=Astro.props;
const cfg=config as any;
const seo=cfg?.seo??{};
const footer=cfg?.footer??{};
const currentYear=new Date().getFullYear();
const siteTitle=seo.title||'Classic Reporters';
const logo=seo.footerLogo||seo.logo||'/classic-assets/9386b5086f1935ab.png';
const description=footer.description||seo.description||'National news, reported plainly. Original reporting, clearly attributed.';
const editorialEmail=footer.editorialEmail||'editorial@classicreporters.com';
const infoEmail=footer.infoEmail||'info@classicreporters.com';
const ctaTitle=footer.ctaTitle||'Story tips, corrections, and letters to the editor all reach a real editor.';
const ctaButtonText=footer.ctaButtonText||'Contact the newsroom';
const ctaButtonLink=footer.ctaButtonLink||'/contact/';
const defaults=[{label:'U.S. News',href:'/us-news/'},{label:'World News',href:'/world-news/'},{label:'Business',href:'/business/'},{label:'Technology',href:'/technology/'},{label:'Health',href:'/health/'},{label:'Entertainment',href:'/entertainment/'},{label:'Lifestyle',href:'/lifestyle/'}];
const configured=((navigation?.items??[]) as NavItem[]).filter((item)=>item?.label&&item?.href);
const sectionLinks=configured.length?configured:defaults;
const companyLinks=[{label:'About Us',href:'/about/'},{label:'Our Team',href:'/our-team/'},{label:'Contact Us',href:'/contact/'},{label:'Editorial Guidelines',href:'/editorial-guidelines/'},{label:'Write for Us',href:'/write-for-us/'}];
const legalLinks=[{label:'Privacy Policy',href:'/privacy-policy/'},{label:'Terms of Use',href:'/terms-of-use/'},{label:'Cookie Policy',href:'/cookie-policy/'},{label:'DMCA Policy',href:'/dmca-policy/'},{label:'AI Policy',href:'/ai-policy/'},{label:'Sponsored Content Policy',href:'/sponsored-content-policy/'}];
---
<section class="cr-cta" aria-label="Contact the newsroom"><div class="cr-cta-inner"><h2 data-tina-field={footer?tinaField(footer,'ctaTitle'):undefined}>{ctaTitle}</h2><a href={ctaButtonLink} data-tina-field={footer?tinaField(footer,'ctaButtonText'):undefined}>{ctaButtonText}<span>→</span></a></div></section>
<footer class="cr-footer" data-brand-footer>
  <div class="cr-footer-inner">
    <div class="cr-footer-brand">
      <a href="/" aria-label={`${siteTitle} home`}><img src={logo} alt={siteTitle} data-tina-field={seo?tinaField(seo,'footerLogo'):undefined} /></a>
      <p data-tina-field={footer?tinaField(footer,'description'):undefined}>{description}</p>
      <a href={`mailto:${editorialEmail}`} data-tina-field={footer?tinaField(footer,'editorialEmail'):undefined}>{editorialEmail}</a>
      <a href={`mailto:${infoEmail}`} data-tina-field={footer?tinaField(footer,'infoEmail'):undefined}>{infoEmail}</a>
    </div>
    <div class="cr-footer-sections"><span>Sections</span><nav>{sectionLinks.map((item)=><a href={item.href||'#'} data-tina-field={configured.length?tinaField(item,'label'):undefined}>{item.label}</a>)}</nav></div>
    <div class="cr-footer-company"><span>Company</span><nav>{companyLinks.map((item)=><a href={item.href}>{item.label}<i>↗</i></a>)}</nav></div>
  </div>
  <div class="cr-footer-legal"><span>© {currentYear} {siteTitle}. All rights reserved.</span><nav>{legalLinks.map((item)=><a href={item.href}>{item.label}</a>)}</nav></div>
</footer>
