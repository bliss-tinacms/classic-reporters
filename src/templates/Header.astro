---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/data';

interface Props {
  config?: CmsConfig | null;
  navigation?: NavigationDocument | null;
}

type NavItem = {
  label?: string | null;
  href?: string | null;
  children?: (NavItem | null)[] | null;
};

type NavigationDocument = {
  title?: string | null;
  items?: (NavItem | null)[] | null;
};

const { config, navigation } = Astro.props;
const cfg = config as any;
const seo = cfg?.seo ?? null;
const siteTitle = seo?.title || 'Classic Reporters';
const logo = seo?.logo || '/classic-assets/9386b5086f1935ab.png';
const defaults: NavItem[] = [
  { label: 'U.S. News', href: '/us-news/' },
  { label: 'World News', href: '/world-news/' },
  { label: 'Business', href: '/business/' },
  { label: 'Technology', href: '/technology/' },
  { label: 'Health', href: '/health/' },
  { label: 'Entertainment', href: '/entertainment/' },
  { label: 'Lifestyle', href: '/lifestyle/' },
];
const configured = ((navigation?.items ?? []) as NavItem[]).filter(
  (item) => item?.label && item?.href,
);
const menuItems = configured.length ? configured : defaults;
---

<header class="cr-exact-header" data-brand-header>
  <div class="cr-exact-header__inner">
    <a class="cr-exact-header__logo" href="/" aria-label={`${siteTitle} home`}>
      <img
        src={logo}
        alt={siteTitle}
        data-tina-field={seo ? tinaField(seo, 'logo') : undefined}
      />
    </a>
    <button
      class="cr-exact-header__menu-button"
      type="button"
      aria-label="Toggle navigation menu"
      aria-controls="cr-primary-navigation"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav
      id="cr-primary-navigation"
      class="cr-exact-header__nav"
      aria-label={navigation?.title || 'Primary navigation'}
    >
      {
        menuItems.map((item, index) => (
          <a
            href={item.href || '#'}
            data-tina-field={configured.length ? tinaField(item, 'label') : undefined}
          >
            <sup>{String(index + 1).padStart(2, '0')}</sup>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const breakpoint = window.matchMedia('(max-width: 1024px)');

    document.querySelectorAll('[data-brand-header]').forEach((header) => {
      const button = header.querySelector('.cr-exact-header__menu-button');
      const nav = header.querySelector('.cr-exact-header__nav');
      if (!button || !nav || button.dataset.bound === 'true') return;

      button.dataset.bound = 'true';

      const setOpen = (open, returnFocus = false) => {
        const shouldOpen = breakpoint.matches && open;
        header.classList.toggle('is-menu-open', shouldOpen);
        button.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
        if (returnFocus) button.focus();
      };

      button.addEventListener('click', () => {
        setOpen(button.getAttribute('aria-expanded') !== 'true');
      });

      nav.addEventListener('click', (event) => {
        if (event.target.closest('a')) setOpen(false);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false, true);
        }
      });

      const handleBreakpoint = () => setOpen(false);
      if (breakpoint.addEventListener) breakpoint.addEventListener('change', handleBreakpoint);
      else breakpoint.addListener(handleBreakpoint);
    });
  })();
</script>
