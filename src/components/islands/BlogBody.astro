---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { getBlogPermalink } from '../../lib/permalinks';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsBlog } from '../../lib/data';
import { mdxComponents } from '../mdx/components';
import '../../styles/classic-article-exact-v2.css';

interface Props {
  data?: CmsBlog | null;
  relatedPosts?: CmsBlog[];
}

const { data, relatedPosts = [] } = Astro.props;

type ReferenceObject = {
  title?: string | null;
  name?: string | null;
  _sys?: { filename?: string | null } | null;
};
type AuthorObject = ReferenceObject & {
  role?: string | null;
  avatar?: string | null;
  bio?: string | null;
  email?: string | null;
};
type RichNode = {
  type?: string;
  text?: string;
  children?: RichNode[];
  [key: string]: unknown;
};

function referenceItems(reference: unknown): unknown[] {
  return Array.isArray(reference) ? reference.filter(Boolean) : reference ? [reference] : [];
}
function referenceLabel(reference: unknown) {
  const labels = referenceItems(reference).map((value) => {
    if (typeof value === 'string') {
      return value.split('/').pop()?.replace(/\.(json|mdx?)$/, '').split('-').map((word) => {
        if (word.toLowerCase() === 'us') return 'U.S.';
        return word ? word[0].toUpperCase() + word.slice(1) : word;
      }).join(' ');
    }
    if (value && typeof value === 'object') {
      const item = value as ReferenceObject;
      return item.title || item.name || null;
    }
    return null;
  }).filter(Boolean) as string[];
  return labels.length ? labels.join(', ') : null;
}
function referenceSlug(reference: unknown) {
  const value = referenceItems(reference)[0];
  if (typeof value === 'string') return value.split('/').pop()?.replace(/\.(json|mdx?)$/, '') || null;
  if (value && typeof value === 'object') {
    const item = value as ReferenceObject;
    return item._sys?.filename || String(item.title || item.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || null;
  }
  return null;
}
function categoriesOf(post?: Partial<CmsBlog> | null) {
  const categories = (post as any)?.categories;
  if (Array.isArray(categories) && categories.length) return categories.map((item) => typeof item === 'string' ? item : item?.category || item).filter(Boolean);
  return (post as any)?.category;
}
function textOf(node: unknown): string {
  if (!node || typeof node !== 'object') return '';
  const item = node as RichNode;
  if (typeof item.text === 'string') return item.text;
  return Array.isArray(item.children) ? item.children.map(textOf).join('') : '';
}
function slugify(value: string) {
  return value.toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'section';
}
function tocFrom(body: unknown) {
  if (!body || typeof body !== 'object') return [];
  const counts = new Map<string, number>();
  return (((body as RichNode).children || []).filter((node) => node?.type === 'h2').map((node) => {
    const title = textOf(node).trim();
    if (!title) return null;
    const base = slugify(title);
    const count = counts.get(base) || 0;
    counts.set(base, count + 1);
    return { title, id: count ? `${base}-${count + 1}` : base };
  }).filter(Boolean)) as Array<{ title: string; id: string }>;
}
function fallbackDate(post?: CmsBlog | null) {
  if (!post?._sys?.filename) return new Date();
  try { return statSync(join(process.cwd(), 'src', 'content', 'blog', `${post._sys.filename}.mdx`)).mtime; }
  catch { return new Date(); }
}
function shortDate(value: Date) {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(value);
}
function shortCardDate(value: Date) {
  return new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(value);
}
function timeET(value: Date) {
  return new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }).format(value).toLowerCase().replace(' ', ' ') + ' ET';
}
function readingMinutes(body: unknown) {
  return Math.max(1, Math.ceil(textOf(body).trim().split(/\s+/).filter(Boolean).length / 225));
}
function postUrl(post: CmsBlog) { return getBlogPermalink(post); }

const post = data as (CmsBlog & Record<string, any>) | null | undefined;
const author = post?.author && typeof post.author === 'object' ? post.author as AuthorObject : null;
const authorName = referenceLabel(author) || referenceLabel(post?.author) || 'Site Staff';
const authorSlug = referenceSlug(post?.author) || referenceSlug(author);
const authorUrl = authorSlug ? `/blog/author/${authorSlug}/` : '/blog/';
const initials = authorName.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]?.toUpperCase()).join('') || 'SS';
const categoryRefs = categoriesOf(post);
const primaryCategory = referenceItems(categoryRefs)[0];
const categoryLabel = referenceLabel(primaryCategory) || 'Article';
const categorySlug = referenceSlug(primaryCategory);
const categoryUrl = categorySlug ? `/blog/category/${categorySlug}/` : '/blog/';
const published = post?.pubDate ? new Date(post.pubDate) : fallbackDate(post);
const updated = post?.updatedDate ? new Date(post.updatedDate) : null;
const tocItems = tocFrom(post?.body);
const words = readingMinutes(post?.body);
const heroAlt = post?.heroImageAlt || post?.featuredImageAlt || post?.imageAlt || post?.title || 'Article lead image';
const heroCaption = post?.heroImageCaption || post?.heroCaption || post?.caption || null;
const articleStatus = post?.articleType || post?.status || 'News';
---

<main class="cr-article-v2">
  {post && (
    <>
      <article class="crav-article">
        <header class="crav-head">
          <nav class="crav-crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a><span aria-hidden="true">/</span>
            <a href={categoryUrl} data-tina-field={tinaField(post, 'categories')}>{categoryLabel}</a>
            <span class="crav-status">{articleStatus}</span>
          </nav>
          {post.title && <h1 data-tina-field={tinaField(post, 'title')}>{post.title}</h1>}
          <div class="crav-byline">
            <div class="crav-author">
              <a class="crav-avatar-link" href={authorUrl} aria-label={`View ${authorName} archive`}>
                {author?.avatar
                  ? <img class="crav-avatar" src={author.avatar} alt="" width="52" height="52" />
                  : <span class="crav-avatar crav-initials" aria-hidden="true">{initials}</span>}
              </a>
              <div class="crav-author-copy" data-tina-field={tinaField(post, 'author')}>
                <div>By <a href={authorUrl}>{authorName}</a></div>
                <div class="crav-meta">
                  <span data-tina-field={tinaField(post, 'pubDate')}>Published {shortDate(published)}</span>
                  {updated && <><span aria-hidden="true"> · </span><span data-tina-field={tinaField(post, 'updatedDate')}>Updated {timeET(updated)}</span></>}
                  <span aria-hidden="true"> · </span><span>{words} min read</span>
                </div>
              </div>
            </div>
          </div>
        </header>

        {post.heroImage && (
          <figure class="crav-hero" data-tina-field={tinaField(post, 'heroImage')}>
            <img src={post.heroImage} alt={heroAlt} width="1120" height="630" />
            {heroCaption && <figcaption>{heroCaption}</figcaption>}
          </figure>
        )}

        <div class="crav-layout">
          {tocItems.length > 0 && (
            <nav class="crav-toc crav-mobile-toc" aria-label="Table of contents">
              <div class="crav-side-label">In this article</div>
              <div class="crav-toc-links">
                <span class="crav-toc-rule" aria-hidden="true"></span>
                {tocItems.map((item, index) => (
                  <a href={`#${item.id}`} class:list={['crav-toc-link', { active: index === 0 }]} data-toc-link={item.id}>
                    <span aria-hidden="true"></span>{item.title}
                  </a>
                ))}
              </div>
            </nav>
          )}

          <div id="article-body" class="crav-prose" data-toc-ids={JSON.stringify(tocItems.map(({ id }) => id))}>
            {post.body && (
              <div data-tina-field={tinaField(post, 'body')}>
                {typeof post.body === 'string' ? <p>{post.body}</p> : <TinaMarkdown content={post.body} components={mdxComponents} />}
              </div>
            )}

            <section class="crav-author-box" data-tina-field={tinaField(post, 'author')} aria-labelledby="crav-author-name">
              {author?.avatar
                ? <img src={author.avatar} alt="" width="64" height="64" />
                : <span class="crav-box-initials" aria-hidden="true">{initials}</span>}
              <div>
                <div class="crav-author-label">About the author</div>
                <div class="crav-author-name" id="crav-author-name"><a href={authorUrl}>{authorName}</a></div>
                <div class="crav-author-bio">{author?.bio || `${authorName} is a Classic Reporters newsroom contributor.`}</div>
              </div>
            </section>
          </div>

          <div class="crav-standards crav-mobile-standards">
            <div class="crav-side-label">Our standards</div>
            <p>News is labeled news, analysis is labeled analysis, and corrections are made openly on the record.</p>
            <a href="/editorial-guidelines">Editorial guidelines →</a>
          </div>

          <aside class="crav-aside">
            <div class="crav-sticky">
              {tocItems.length > 0 && (
                <nav class="crav-toc" aria-label="Table of contents">
                  <div class="crav-side-label">In this article</div>
                  <div class="crav-toc-links">
                    <span class="crav-toc-rule" aria-hidden="true"></span>
                    {tocItems.map((item, index) => (
                      <a href={`#${item.id}`} class:list={['crav-toc-link', { active: index === 0 }]} data-toc-link={item.id}>
                        <span aria-hidden="true"></span>{item.title}
                      </a>
                    ))}
                  </div>
                </nav>
              )}
              <div class="crav-standards">
                <div class="crav-side-label">Our standards</div>
                <p>News is labeled news, analysis is labeled analysis, and corrections are made openly on the record.</p>
                <a href="/editorial-guidelines">Editorial guidelines →</a>
              </div>
            </div>
          </aside>
        </div>
      </article>

      {relatedPosts.length > 0 && (
        <section class="crav-related" aria-labelledby="crav-related-title">
          <div class="crav-related-inner">
            <header>
              <h2 id="crav-related-title">Related reporting</h2>
              <a href={categoryUrl}>More in {categoryLabel} →</a>
            </header>
            <div class="crav-related-grid">
              {relatedPosts.slice(0, 3).map((related) => {
                const relatedDate = related.pubDate ? new Date(related.pubDate) : fallbackDate(related);
                return (
                  <a class="crav-related-card" href={postUrl(related)}>
                    {related.heroImage && <img src={related.heroImage} alt={(related as any).heroImageAlt || ''} width="900" height="600" />}
                    <span class="crav-card-category">{referenceLabel(referenceItems(categoriesOf(related))[0]) || 'Article'}</span>
                    <span class="crav-card-title">{related.title || 'Untitled story'}</span>
                    <span class="crav-card-meta">{shortCardDate(relatedDate)} · {readingMinutes(related.body)} min read</span>
                  </a>
                );
              })}
            </div>
          </div>
        </section>
      )}

      <script is:inline>
        (() => {
          const root = document.querySelector('.cr-article-v2');
          if (!root) return;
          const prose = root.querySelector('.crav-prose[data-toc-ids]');
          if (!prose) return;
          let ids = [];
          try { ids = JSON.parse(prose.getAttribute('data-toc-ids') || '[]'); } catch (_) {}
          const headings = [...prose.querySelectorAll('h2')];
          headings.forEach((heading, index) => { if (ids[index] && !heading.id) heading.id = ids[index]; });
          const links = [...root.querySelectorAll('[data-toc-link]')];
          if (!links.length || !('IntersectionObserver' in window)) return;
          const activate = (id) => links.forEach((link) => link.classList.toggle('active', link.getAttribute('data-toc-link') === id));
          const observer = new IntersectionObserver((entries) => {
            const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
            if (visible) activate(visible.target.id);
          }, { rootMargin: '-15% 0px -70% 0px' });
          headings.forEach((heading) => observer.observe(heading));
        })();
      </script>
    </>
  )}
</main>
