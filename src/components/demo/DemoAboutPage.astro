---
import { tinaField } from '@tinacms/astro/tina-field';
const { data = null } = Astro.props;
const block = Array.isArray(data?.blocks) ? data.blocks[0] : data;
const hero = block?.hero || {};
const purpose = block?.purpose || {};
const coverage = block?.coverage || {};
const standards = block?.standardsSection || {};
const coverageItems = Array.isArray(coverage?.items) ? coverage.items : [];
const standardItems = Array.isArray(standards?.items) ? standards.items : [];
---

<main class="ffn-demo cr-about">
  <section class="cr-about-hero"><div class="w cr-about-hero-grid">
    <div class="cr-about-copy">
      <div class="eye"><i></i><span data-tina-field={tinaField(hero,'eyebrow')}>{hero.eyebrow}</span></div>
      <h1 data-tina-field={tinaField(hero,'headline')}>{hero.headline}</h1>
      <p data-tina-field={tinaField(hero,'lede')}>{hero.lede}</p>
    </div>
    <figure class="cr-about-visual">
      <img src={hero.image} alt={hero.imageAlt || ''} data-tina-field={tinaField(hero,'image')} />
      <blockquote data-tina-field={tinaField(hero,'quote')}>“{hero.quote}”</blockquote>
    </figure>
  </div></section>

  <section class="cr-about-newsroom"><div class="w cr-about-newsroom-grid">
    <div class="cr-about-newsroom-intro">
      <div class="eye"><i></i><span data-tina-field={tinaField(purpose,'eyebrow')}>{purpose.eyebrow}</span></div>
      <h2 data-tina-field={tinaField(purpose,'title')}>{purpose.title}</h2>
      <a href="/our-team/">Meet the team →</a>
    </div>
    <div class="cr-about-newsroom-copy">
      <p data-tina-field={tinaField(purpose,'paragraphOne')}>{purpose.paragraphOne}</p>
      <p data-tina-field={tinaField(purpose,'paragraphTwo')}>{purpose.paragraphTwo}</p>
      <div class="cr-about-pref-grid">
        <article><b>We prefer</b><p>Named sources to anonymous ones.</p></article>
        <article><b>We prefer</b><p>Verifiable claims to insider chatter.</p></article>
      </div>
    </div>
  </div></section>

  <section class="cr-about-coverage"><div class="w">
    <div class="eye light"><i></i><span data-tina-field={tinaField(coverage,'eyebrow')}>{coverage.eyebrow}</span></div>
    <h2 data-tina-field={tinaField(coverage,'title')}>{coverage.title}</h2>
    <p class="cr-about-coverage-intro" data-tina-field={tinaField(coverage,'intro')}>{coverage.intro}</p>
    <div class="cr-about-coverage-grid">
      {coverageItems.map((item:any,index:number)=><a class:list={['cr-about-coverage-card',index===0&&'feature']} href={item.link||'#'}>
        <img src={item.image} alt={item.imageAlt||''} data-tina-field={tinaField(item,'image')} />
        <span class="shade"></span><span class="copy"><small>{item.number}</small><strong data-tina-field={tinaField(item,'title')}>{item.title}</strong><em data-tina-field={tinaField(item,'text')}>{item.text}</em></span>
      </a>)}
    </div>
  </div></section>

  <section class="cr-about-commitments"><div class="w">
    <div class="cr-about-commitments-head"><div><div class="eye"><i></i><span data-tina-field={tinaField(standards,'eyebrow')}>{standards.eyebrow}</span></div><h2 data-tina-field={tinaField(standards,'title')}>{standards.title}</h2></div><a href="/editorial-guidelines/">Read our editorial guidelines →</a></div>
    <div class="cr-about-commitments-grid">{standardItems.map((item:any)=><article><span data-tina-field={tinaField(item,'number')}>{item.number}</span><h3 data-tina-field={tinaField(item,'title')}>{item.title}</h3><p data-tina-field={tinaField(item,'text')}>{item.text}</p></article>)}</div>
  </div></section>
</main>
