---
import { tinaField } from '@tinacms/astro/tina-field';
import { getBlogPermalink } from '../../lib/permalinks';
import { labelFromReference, getAuthorName, getPostCategories } from './DemoHelpers';
const { archiveTitle='Category',posts=[],currentPage=1,totalPages=1,basePath='/',category=null }=Astro.props;
const lead=posts[0],rest=posts.slice(1),leadImage=category?.featuredImage||lead?.heroImage;
const url=(p:any)=>{const u=getBlogPermalink(p);return u.endsWith('/')?u:u+'/'};
const pagePath=(p:number)=>p<=1?basePath+'/':basePath+'/page/'+p+'/';
---
<main class="cr-exact-category">
  <header class="crx-wrap crx-cat-head"><nav class="crx-crumbs"><a href="/">Home</a><span>/</span><span>{archiveTitle}</span></nav><h1 data-tina-field={category?tinaField(category,'title'):undefined}>{archiveTitle}</h1></header>
  {lead&&<section class="crx-wrap"><a class="crx-lead" href={url(lead)}>{leadImage?<div class="crx-lead-img" role="img" aria-label={category?.featuredImageAlt||lead?.heroImageAlt||''} style={`background-image:url(${leadImage})`} data-tina-field={category?.featuredImage?tinaField(category,'featuredImage'):undefined}></div>:<div class="crx-lead-img"></div>}<span class="crx-lead-copy"><span class="crx-pill">Latest · {labelFromReference(getPostCategories(lead),archiveTitle)}</span><span class="crx-lead-title">{lead.title}</span>{lead.description&&<span class="crx-lead-desc">{lead.description}</span>}<span class="crx-meta">By {getAuthorName(lead.author)}</span></span></a></section>}
  <section class="crx-wrap crx-list">{rest.length?<div class="crx-card-grid">{rest.map((post:any)=><a href={url(post)} class="crx-story">{post.heroImage?<img src={post.heroImage} alt={post.heroImageAlt||''}/>:<span class="crx-story-img"></span>}<span class="crx-story-k">{labelFromReference(getPostCategories(post),archiveTitle)}</span><span class="crx-story-title">{post.title}</span>{post.description&&<span class="crx-story-desc">{post.description}</span>}<span class="crx-story-meta">By {getAuthorName(post.author)}</span></a>)}</div>:<p>There are no additional articles published yet under this category. Please check back soon for new coverage.</p>}
  {totalPages>1&&<nav class="crx-pagination" aria-label="Archive pagination"><a class={currentPage<=1?'disabled':''} href={pagePath(Math.max(1,currentPage-1))}>← Newer</a>{Array.from({length:Math.min(totalPages,4)}).map((_,i)=>{const p=i+1;return <a class={p===currentPage?'on':''} href={pagePath(p)}>{p}</a>})}<a href={pagePath(Math.min(totalPages,currentPage+1))}>Older →</a></nav>}</section>
</main>
