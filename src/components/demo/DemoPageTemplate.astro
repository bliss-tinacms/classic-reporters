---
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import { tinaField } from '@tinacms/astro/tina-field';

const { data } = Astro.props;
const contentBlock = Array.isArray(data?.blocks)
  ? data.blocks.find((block: any) => block?.__typename === 'PageBlocksContent' || block?._template === 'content')
  : null;
const title = data?.title || data?.seoTitle || 'Editorial Guidelines';
---

<main class="cr-exact-page">
  <article>
    <h1 data-tina-field={data ? tinaField(data, 'title') : undefined}>{title}</h1>
    <div class="cr-exact-page__content" data-tina-field={contentBlock ? tinaField(contentBlock, 'body') : undefined}>
      {contentBlock?.body && <TinaMarkdown content={contentBlock.body} />}
    </div>
  </article>
</main>
