---
const { categories = [] } = Astro.props;
const sourceOrder = ['us-news', 'world-news', 'business', 'technology', 'health', 'entertainment', 'lifestyle'];
const sections = categories
  .map((category: any) => ({
    label: String(category?.title || category?._sys?.filename || '').trim(),
    slug: String(category?._sys?.filename || '').trim(),
  }))
  .filter((category: { label: string; slug: string }) => category.label && category.slug)
  .sort((left: { slug: string }, right: { slug: string }) => {
    const leftIndex = sourceOrder.indexOf(left.slug.toLowerCase());
    const rightIndex = sourceOrder.indexOf(right.slug.toLowerCase());
    return (leftIndex < 0 ? sourceOrder.length : leftIndex) - (rightIndex < 0 ? sourceOrder.length : rightIndex);
  });
function sectionUrl(slug: string) { return '/' + slug.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '/'; }
---

<main class="cr-exact-404">
  <section class="crx-wrap">
    <div class="crx-404-grid">
      <div class="crx-404-num">404</div>
      <div class="crx-404-copy">
        <span class="crx-404-kicker"><span></span>Page not found</span>
        <h1>We couldn’t find that page.</h1>
        <p>The link may be broken, or the page may have moved. If you followed a link from one of our articles, let the newsroom know and we’ll fix it.</p>
        <div class="crx-actions">
          <a href="/">Back to the homepage</a>
          <a href="/contact/">Report a broken link</a>
        </div>
      </div>
    </div>
    <div class="crx-browse">
      <span class="crx-browse-label">Browse a section</span>
      <div>
        {sections.map((section: { label: string; slug: string }) => <a href={sectionUrl(section.slug)}>{section.label}</a>)}
      </div>
    </div>
  </section>
</main>
