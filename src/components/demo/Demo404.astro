---
const { categories = [] } = Astro.props;
const sections = categories
  .map((category: any) => ({
    label: String(category?.title || category?._sys?.filename || '').trim(),
    slug: String(category?._sys?.filename || '').trim(),
  }))
  .filter((category: { label: string; slug: string }) => category.label && category.slug);
function sectionUrl(slug: string) { return '/' + slug.toLowerCase().replace(/[^a-z0-9]+/g, '-') + '/'; }
---

<main class="ffn-demo ffn-demo-404">
  <section class="er"><div class="w"><div class="er-in"><span class="er-num">404</span><div class="er-b"><div class="er-k"><b>Page not found</b></div><h1>This page is not here.</h1><p>The link may be broken, or the story may have moved. Nothing was deleted quietly — if a piece was taken down or corrected, we say so on the page.</p><div class="er-cta"><a href="/" class="pri">Back to the homepage →</a><a href="/contact/" class="sec">Report a broken link</a></div></div></div></div></section>
  <section class="bd2"><div class="w"><div class="eye"><i></i><span>Or start from a section</span></div><div class="h2">Browse coverage</div><div class="bd2-g">
    {sections.map((section: { label: string; slug: string }, index: number) => <a href={sectionUrl(section.slug)} class="bd2-i"><div class="bd2-n">{String(index + 1).padStart(2, '0')}</div><div class="bd2-t">{section.label}</div></a>)}
  </div></div></section>
</main>
