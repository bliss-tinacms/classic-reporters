---
import Base from '../layouts/Base.astro';
import { listBlogs, listPages } from '../lib/data';
import { getBlogPermalink, getPageRouteSlug } from '../lib/permalinks';
import '../styles/classic-sitemap.css';

export const prerender = false;

const pages = await listPages();
const posts = await listBlogs();

const title = 'Sitemap | Classic Reporters';
const description = 'Browse the public pages and latest reporting published by Classic Reporters.';

function cleanTitle(value: unknown, fallback = 'Untitled') {
  return typeof value === 'string' && value.trim() ? value.trim() : fallback;
}

function withTrailingSlash(value: string) {
  if (!value || value === '/') return '/';
  const normalized = value.startsWith('/') ? value : '/' + value;
  return normalized.endsWith('/') ? normalized : normalized + '/';
}

function pageUrl(page: any) {
  const filename = page?._sys?.filename || '';
  if (filename === 'home') return '/';
  return withTrailingSlash(getPageRouteSlug(page) || filename);
}

function postUrl(post: any) {
  return withTrailingSlash(getBlogPermalink(post));
}

function isHiddenPage(page: any) {
  const filename = page?._sys?.filename || '';
  const url = pageUrl(page);
  return Boolean(
    page?.draft ||
    page?.seo?.noindex ||
    filename === '404' ||
    filename === 'sitemap' ||
    url === '/sitemap/'
  );
}

function isHiddenPost(post: any) {
  return Boolean(post?.draft || post?.seo?.noindex);
}

type SitemapLink = { title: string; url: string };
type SitemapPostLink = SitemapLink & { date: Date | null };

const pageLinks: SitemapLink[] = (pages as any[])
  .filter((page: any) => !isHiddenPage(page))
  .map((page: any): SitemapLink => ({
    title: cleanTitle(page.title || page.seoTitle || page.seo?.metaTitle, page?._sys?.filename || 'Page'),
    url: pageUrl(page),
  }))
  .sort((a: SitemapLink, b: SitemapLink) => {
    if (a.url === '/') return -1;
    if (b.url === '/') return 1;
    return a.title.localeCompare(b.title);
  });

const postLinks: SitemapPostLink[] = (posts as any[])
  .filter((post: any) => !isHiddenPost(post))
  .map((post: any): SitemapPostLink => ({
    title: cleanTitle(post.title || post.seo?.metaTitle, post?._sys?.filename || 'Story'),
    url: postUrl(post),
    date: post.pubDate ? new Date(post.pubDate) : null,
  }))
  .sort((a: SitemapPostLink, b: SitemapPostLink) => Number(b.date || 0) - Number(a.date || 0));

const totalLinks = pageLinks.length + postLinks.length;
const latestPost = postLinks[0] ?? null;
const updated = new Date();
---

<Base
  title={title}
  description={description}
  ogTitle={title}
  ogDescription={description}
  canonicalUrl="/sitemap/"
>
  <main class="cr-sitemap" aria-labelledby="sitemap-title">
    <header class="cr-sitemap__hero">
      <div class="cr-sitemap__shell">
        <div class="cr-sitemap__eyebrow"><span></span>Explore Classic Reporters</div>
        <div class="cr-sitemap__hero-grid">
          <h1 id="sitemap-title">Sitemap</h1>
          <div class="cr-sitemap__hero-copy">
            <p>Every public page and published story, organized in one clear directory.</p>
            <p class="cr-sitemap__updated">Updated automatically as new reporting is published.</p>
          </div>
        </div>
        <div class="cr-sitemap__metrics" aria-label="Sitemap totals">
          <div><strong>{pageLinks.length}</strong><span>Pages</span></div>
          <div><strong>{postLinks.length}</strong><span>Stories</span></div>
          <div><strong>{totalLinks}</strong><span>Total links</span></div>
        </div>
      </div>
    </header>

    <section class="cr-sitemap__directory" aria-labelledby="sitemap-directory-title">
      <div class="cr-sitemap__shell">
        <div class="cr-sitemap__section-head">
          <div>
            <div class="cr-sitemap__kicker">Site directory</div>
            <h2 id="sitemap-directory-title">Everything in one place.</h2>
          </div>
          <div class="cr-sitemap__section-note">
            <p>Browse our main pages or go directly to the latest reporting from the newsroom.</p>
            <p><time datetime={updated.toISOString()}>Current as of {updated.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>{latestPost ? ` · Latest: ${latestPost.title}` : ''}</p>
          </div>
        </div>

        <div class="cr-sitemap__grid">
          <section class="cr-sitemap__panel cr-sitemap__panel--pages" aria-labelledby="sitemap-pages-title">
            <div class="cr-sitemap__panel-head">
              <div>
                <span>Public pages</span>
                <h2 id="sitemap-pages-title">Website pages</h2>
              </div>
              <b>{pageLinks.length}</b>
            </div>
            {pageLinks.length > 0 ? (
              <ol class="cr-sitemap__list">
                {pageLinks.map((item: SitemapLink, index: number) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <a href={item.url}>{item.title}</a>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="cr-sitemap__empty">No public pages found.</p>
            )}
          </section>

          <section class="cr-sitemap__panel cr-sitemap__panel--stories" aria-labelledby="sitemap-posts-title">
            <div class="cr-sitemap__panel-head">
              <div>
                <span>Published reporting</span>
                <h2 id="sitemap-posts-title">Latest stories</h2>
              </div>
              <b>{postLinks.length}</b>
            </div>
            {postLinks.length > 0 ? (
              <ol class="cr-sitemap__list cr-sitemap__list--stories">
                {postLinks.map((item: SitemapPostLink, index: number) => (
                  <li>
                    <span>{String(index + 1).padStart(2, '0')}</span>
                    <a href={item.url}>{item.title}</a>
                    {item.date && <time datetime={item.date.toISOString()}>{item.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>}
                  </li>
                ))}
              </ol>
            ) : (
              <p class="cr-sitemap__empty">No published stories found.</p>
            )}
          </section>
        </div>
      </div>
    </section>
  </main>
</Base>
